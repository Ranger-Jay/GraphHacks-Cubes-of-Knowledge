# Local synthetic demonstration only. Never commit the real .env file.
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=wad_studio
# Empty only for loopback local Docker. Configure auth/TLS for remote instances.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# Server-only signing key, independently generated per environment. No default.
# Use: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# The graph lane must fail closed when unset; never expose this to Vite/browser code.
GRAPH_EVIDENCE_KEY=
# Required server-only durable directory for the evidence witness, outside FalkorDB.
# Create an owner-only directory and set its absolute path; do not silently initialize it.
# Keep it across server restarts and separate from graph-only snapshot restoration.
GRAPH_WITNESS_DIR=
# Bootstrap choice; runtime lane must replace with a verified immutable digest.
FALKORDB_IMAGE=falkordb/falkordb:latest
# Agent calls stay disabled until a real provider is configured and tested.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# API lane supplies a non-default local session secret; no fake demo identity.
SESSION_SECRET=
