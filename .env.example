# Local synthetic demonstration only. Never commit the real .env file.
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=wad_studio
# Empty only for loopback local Docker. Configure auth/TLS for remote instances.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# Bootstrap choice; runtime lane must replace with a verified immutable digest.
FALKORDB_IMAGE=falkordb/falkordb:latest
# Agent calls stay disabled until a real provider is configured and tested.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# API lane supplies a non-default local session secret; no fake demo identity.
SESSION_SECRET=
# API sessions: the variable name is the principal, the token text is only a secret. Leave empty here;
# mint 8-256 chars of [A-Za-z0-9._~-] outside the repo and put them in your local .env only. Empty = absent.
# The dev web proxy (apps/web/dev-proxy.ts) reads API_READER_TOKEN only, on the dev machine; it is never
# sent to the browser. Do not give any of these a VITE_ prefix.
API_OWNER_TOKEN=
API_READER_TOKEN=
API_AGENT_TOKEN=
