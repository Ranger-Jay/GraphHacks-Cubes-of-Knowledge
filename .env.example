# Local synthetic demonstration only. Never commit the real .env file.
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_TIMEOUT_MS=3000
FALKORDB_GRAPH=wad_studio
# Empty only for loopback local Docker. Configure auth/TLS for remote instances.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# Server-only signing key, independently generated per environment. No default.
# Use: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# The graph lane must fail closed when unset; never expose this to Vite/browser code.
GRAPH_EVIDENCE_KEY=
# Required server-only durable directory for the evidence witness, outside FalkorDB.
# Create an owner-only directory and set its absolute path; do not silently initialize it.
# Keep it across server restarts and separate from graph-only snapshot restoration.
GRAPH_WITNESS_DIR=
# Bootstrap choice; runtime lane must replace with a verified immutable digest.
FALKORDB_IMAGE=falkordb/falkordb:latest
# Agent calls stay disabled until a real provider is configured and tested.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Server-derived analysis scope. Missing/invalid scope makes analysis unavailable.
API_TENANT_ID=t-wad
# API sessions: the variable name is the principal, the token text is only a secret. Leave empty here;
# mint 8-256 chars of [A-Za-z0-9._~-] outside the repo and put them in your local .env only. Empty = absent.
# The dev web proxy (apps/web/dev-proxy.ts) reads API_READER_TOKEN only, on the dev machine; it is never
# sent to the browser. Do not give any of these a VITE_ prefix.
API_OWNER_TOKEN=
API_READER_TOKEN=
API_AGENT_TOKEN=
# Optional local IdeaVerse owner rehearsal; disabled by default. Uses a separate guarded path.
# API_OWNER_TOKEN stays in the Vite/API Node processes. Never prefix it with VITE_.
API_OWNER_REHEARSAL=0
