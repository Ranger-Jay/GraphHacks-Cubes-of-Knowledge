{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "{graph/seed/**,apps/api/dist/**,packages/graph/dist/**,packages/contracts/dist/**}"
    }
  }
}
